# Backend environment example

# Comma-separated list of allowed origins for CORS. If unset, defaults to http://localhost:3000,http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT settings
# JWT_SECRET_KEY=please_change_me
# JWT_ACCESS_EXPIRES_MIN=10080

# Cookie settings
# NODE_ENV=development
# COOKIE_DOMAIN=localhost
# COOKIE_SAMESITE=lax

# Database - provided by streaming_db container if available
# SQLITE_DB=/absolute/path/to/db/app.db

# Optional site URL used in emails or redirects
# SITE_URL=http://localhost:3000
